* text=auto
*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.ipynb text eol=lf
*.png binary
*.pdf binary

# Published artifact hashes must survive checkout without newline conversion.
reports/benchmarks/** -text
reports/protocols/** -text
reports/local_ops.json -text
reports/service_load.json -text
data/testset.json -text
data/public/corpus.json -text
reports/ann_scale.json -text

reports/releases/r1/** -text

# Preserve renderer path whitespace in generated SVG assets.
reports/releases/r1/figures/*.svg linguist-generated=true -whitespace

reports/releases/r2/** -text

reports/releases/r3/** -text
