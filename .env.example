# Optional private dotenv path, outside the checkout:
# DOCMIND_SECRETS_FILE=
# Hosted models may retire. Inspect available ids with scripts/list_models.py.
# DOCMIND_REASONING_EFFORT=none
# DOCMIND_MAX_TOKENS=2048
# DOCMIND_TOOL_PROTOCOL=react
# DOCMIND_DENSE_INDEX=hnsw

# Default: pinned multilingual E5-small and dense retrieval.
# DOCMIND_RETRIEVAL_MODE=dense
# Explicit alternatives: sparse, hybrid, hybrid_rerank.
# Old BGE corpora and reranker thresholds require explicit migration.

# Current reader and operator policy, forwarded by Compose:
# DOCMIND_ANSWER_STRATEGY=single
# DOCMIND_RELEASE_MODE=draft
# Use strict to require human approval for every fresh answer.
# DOCMIND_ATTRIBUTION=0
# DOCMIND_QUERY_TIMEOUT_SECONDS=30
