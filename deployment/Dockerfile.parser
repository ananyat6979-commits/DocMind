FROM python:3.11-slim@sha256:07d4824036af339fa1b6ef769cc99d9c10a141769538b52b3b597c84f7a7b535
ENV PYTHONUNBUFFERED=1 PYTHONUTF8=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app
WORKDIR /app
COPY locks/parser-linux-py311.txt /tmp/parser-requirements.txt
RUN pip install --no-cache-dir --require-hashes -r /tmp/parser-requirements.txt
COPY docmind ./docmind
COPY scripts/parser_isolation_check.py ./scripts/parser_isolation_check.py
RUN useradd --uid 10001 --no-create-home parser && mkdir -p /run/docmind-parser && chown 10001:10001 /run/docmind-parser
USER 10001:10001
CMD ["python", "-m", "docmind.ingestion.parser_service"]
